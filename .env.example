# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# Pooled connection string used by the app at runtime (Neon/Supabase pooler).
DATABASE_URL="postgresql://user:password@host:5432/portfolio?sslmode=require"
# Direct (non-pooled) connection used by Prisma Migrate. On Neon this is the
# "direct" connection string. Locally it can be the same as DATABASE_URL.
DIRECT_URL="postgresql://user:password@host:5432/portfolio?sslmode=require"

# ---------------------------------------------------------------------------
# Authentication (Auth.js / NextAuth v5)
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
# Base URL of the deployment (used for callbacks). Optional in most cases.
AUTH_URL="http://localhost:3000"

# Seeded admin account (used by prisma/seed.ts to create the first admin user).
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-to-a-strong-password"
ADMIN_NAME="Site Admin"

# ---------------------------------------------------------------------------
# Public site metadata
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Optional: email notifications for contact form (Resend)
# If unset, contact messages are still persisted to the database.
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
CONTACT_NOTIFICATION_EMAIL=""
